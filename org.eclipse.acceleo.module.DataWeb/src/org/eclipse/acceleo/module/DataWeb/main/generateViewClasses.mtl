        nuevo.set[atrib.nombre.toUpperFirst()/]([atrib.nombre/]);
        [elseif (atrib.tipo = TipoAtributo::DECIMAL)]
        double [atrib.nombre/] = ConsoleUtils.leerDecimal(scanner, "[atrib.nombre/]", null, 0.0);
        nuevo.set[atrib.nombre.toUpperFirst()/]([atrib.nombre/]);
        [else]
        String [atrib.nombre/] = ConsoleUtils.leerString(scanner, "[atrib.nombre/]", null, "");
        nuevo.set[atrib.nombre.toUpperFirst()/]([atrib.nombre/]);
        [/if]
        [/for]
        
        try {
            nuevo.validarDatos();
            [entidad.nombre/]DAO dao = [entidad.nombre/]DAO.getInstance();
            dao.save(nuevo);
            ConsoleUtils.mostrarCreacion("[entidad.nombre/]");
        } catch (Exception e) {
            ConsoleUtils.mostrarError("Error al crear [entidad.nombre/]: " + e.getMessage());
        }
        
        ConsoleUtils.pausar(scanner);
    }
