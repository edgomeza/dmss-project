    [if (rol.paginasAccesibles->exists(p | p.oclIsKindOf(PaginaBorrado) and p.oclAsType(PaginaCRUD).entidad = entidad) or entidad.hasCRUD)]
    private void borrar[entidad.nombre/]() {
