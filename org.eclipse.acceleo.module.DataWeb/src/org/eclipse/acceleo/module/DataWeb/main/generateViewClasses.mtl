    [comment Método para actualizar /]
    [if (rol.paginasAccesibles->exists(p | p.oclIsKindOf(PaginaActualizacion) and p.oclAsType(PaginaCRUD).entidad = entidad) or entidad.hasCRUD)]
    private void actualizar[entidad.nombre/]() {
        ConsoleUtils.limpiarPantalla();
