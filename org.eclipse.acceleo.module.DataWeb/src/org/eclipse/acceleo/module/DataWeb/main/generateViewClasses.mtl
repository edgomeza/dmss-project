import java.util.List;

/**
 * Menú específico para el rol [rol.nombre/]
 * [if (rol.descripcion.oclIsUndefined() = false)][rol.descripcion/][/if]
 */
public class Menu[rol.nombre/] {
    private Scanner scanner;
    private AuthManager authManager;
    
    public Menu[rol.nombre/]() {
        scanner = new Scanner(System.in);
        authManager = AuthManager.getInstance();
    }
    
    public void mostrarMenu() {
        // Verificar que el usuario tiene el rol correcto
        if (!authManager.isAuthenticated() || !authManager.tieneRol("[rol.nombre/]")) {
            ConsoleUtils.mostrarError("Acceso denegado. Se requiere el rol [rol.nombre/]");
            ConsoleUtils.pausar(scanner);
            return;
        }
        
        boolean salir = false;
        
        while (!salir) {
            ConsoleUtils.limpiarPantalla();
            ConsoleUtils.mostrarTitulo("Menú [rol.nombre/]");
            System.out.println("[if (rol.descripcion.oclIsUndefined() = false)][rol.descripcion/][/if]");
            ConsoleUtils.mostrarLinea();
            
            mostrarOpciones();
            
            int maxOpcion = [rol.paginasAccesibles->size()/];
            int opcion = ConsoleUtils.leerOpcion(scanner, 0, maxOpcion);
            
            if (opcion == 0) {
                salir = true;
            } else if (opcion >= 1 && opcion <= maxOpcion) {
                ejecutarOpcion(opcion);
            } else {
                ConsoleUtils.mostrarError("Opción no válida");
                ConsoleUtils.pausar(scanner);
            }
        }
    }
    
    private void mostrarOpciones() {
        System.out.println("Páginas disponibles para [rol.nombre/]:");
        [for (i : Integer | Sequence{1..rol.paginasAccesibles->size()})]
        [let pagina : Pagina = rol.paginasAccesibles->at(i)]
        System.out.println("[i/]. [pagina.titulo/]");
        [/let]
        [/for]
        System.out.println("0. Volver al menú principal");
    }
    
    private void ejecutarOpcion(int opcion) {
        switch(opcion) {
            [for (i : Integer | Sequence{1..rol.paginasAccesibles->size()})]
            [let pagina : Pagina = rol.paginasAccesibles->at(i)]
            case [i/]:
                [if (pagina.oclIsKindOf(PaginaHome))]
                mostrarPaginaHome();
                [elseif (pagina.oclIsKindOf(PaginaContenido))]
                mostrarPaginaContenido();
                [elseif (pagina.oclIsKindOf(PaginaIndice) or pagina.oclIsKindOf(PaginaIndicePaginada) or pagina.oclIsKindOf(PaginaIndiceFiltros) or pagina.oclIsKindOf(PaginaIndicePaginadaFiltrada))]
                mostrarIndice[pagina.oclAsType(PaginaCRUD).entidad.nombre/]();
                [elseif (pagina.oclIsKindOf(PaginaDetalle))]
                mostrarDetalle[pagina.oclAsType(PaginaCRUD).entidad.nombre/]();
                [elseif (pagina.oclIsKindOf(PaginaCreacion))]
                crearNuevo[pagina.oclAsType(PaginaCRUD).entidad.nombre/]();
                [elseif (pagina.oclIsKindOf(PaginaActualizacion))]
                actualizar[pagina.oclAsType(PaginaCRUD).entidad.nombre/]();
                [elseif (pagina.oclIsKindOf(PaginaBorrado))]
                borrar[pagina.oclAsType(PaginaCRUD).entidad.nombre/]();
                [else]
                ConsoleUtils.mostrarInfo("Funcionalidad de [pagina.titulo/] disponible");
                ConsoleUtils.pausar(scanner);
                [/if]
                break;
            [/let]
            [/for]
            default:
                ConsoleUtils.mostrarError("Opción no válida");
                ConsoleUtils.pausar(scanner);
        }
    }
    
    [comment Generar métodos para páginas específicas /]
    [for (pagina : Pagina | rol.paginasAccesibles->select(p | p.oclIsKindOf(PaginaHome)))]
    private void mostrarPaginaHome() {
        ConsoleUtils.limpiarPantalla();
        ConsoleUtils.mostrarTitulo("Página de Inicio - [rol.nombre/]");
        System.out.println("Bienvenido al sistema [app.nombre/]");
        System.out.println("[app.descripcion/]");
        
        // Mostrar redes sociales asociadas
        [for (red : RedSocial | pagina.redesSociales)]
        System.out.println("Síguenos en [red.tipo/]: @[red.nombreCuenta/]");
        [/for]
        
        // Mostrar fuentes RSS
        [for (rss : FuenteRSS | pagina.fuentesRSS)]
        System.out.println("RSS: [rss.titulo/] - [rss.url/]");
        [/for]
        
        ConsoleUtils.pausar(scanner);
    }
    [/for]
    
    [for (pagina : Pagina | rol.paginasAccesibles->select(p | p.oclIsKindOf(PaginaContenido)))]
    private void mostrarPaginaContenido() {
        ConsoleUtils.limpiarPantalla();
        ConsoleUtils.mostrarTitulo("[pagina.titulo/]");
        System.out.println("[pagina.oclAsType(PaginaContenido).contenido/]");
