  <eClassifiers xsi:type="ecore:EClass" name="Entidad">
    <eAnnotations source="gmf.node">
      <details key="label" value="nombre"/>
      <details key="color" value="200,200,255"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="R02_crud_incompatible R03_indice_requiere_detalle R05_no_autorreferencia R06_no_referencia_circular R08_solo_una_pagina_indice R09_atributos_pertenecen_entidad"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="R02_crud_incompatible" value="self.hasCRUD implies (not self.hasIndex and not self.hasExtendedIndex and not self.hasDetails and not self.hasCreate and not self.hasUpdate and not self.hasDelete)"/>
      <details key="R03_indice_requiere_detalle" value="(self.hasIndex or self.hasExtendedIndex) implies self.hasDetails"/>
      <details key="R05_no_autorreferencia" value="self.referencias->forAll(r | r.target &lt;> self)"/>
      <details key="R06_no_referencia_circular" value="self.referencias->forAll(r | r.target.referencias->forAll(r2 | r2.target &lt;> self))"/>
      <details key="R08_solo_una_pagina_indice" value="Pagina.allInstances()->select(p | p.oclIsKindOf(PaginaIndice) and p.oclAsType(PaginaCRUD).entidad = self)->size() &lt;= 1"/>
      <details key="R09_atributos_pertenecen_entidad" value="Pagina.allInstances()->select(p | p.oclIsKindOf(PaginaIndice))->forAll(pi | pi.oclAsType(PaginaIndice).atributosMostrados->forAll(a | a.oclContainer() = pi.oclAsType(PaginaCRUD).entidad))"/>
    </eAnnotations>
