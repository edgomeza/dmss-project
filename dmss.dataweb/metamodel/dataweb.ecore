    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="R01_una_sola_pagina_home R04_al_menos_una_red_social_y_rss R06b_al_menos_una_encuesta_y_cuestionario"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="R01_una_sola_pagina_home" value="self.paginas->select(p | p.oclIsTypeOf(PaginaHome))->size() = 1"/>
      <details key="R04_al_menos_una_red_social_y_rss" value="self.redesSociales->size() >= 1 and self.fuentesRSS->size() >= 1"/>
      <details key="R06b_al_menos_una_encuesta_y_cuestionario" value="self.encuestas->size() >= 1 and self.cuestionarios->size() >= 1"/>
    </eAnnotations>
